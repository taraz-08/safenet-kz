# Copy to .env.ai. Never commit real credentials.
POSTGRES_PASSWORD=replace-with-a-long-random-password
SAFENET_ADMIN_CODE=replace-with-a-separate-long-random-code
SAFENET_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SAFENET_SECURE_COOKIE=false
SAFENET_RETENTION_DAYS=30
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8100/events
# Optional OpenAI-compatible LLM. Absent credentials use clearly labelled rules.
SAFENET_LLM_BASE_URL=https://api.openai.com/v1
SAFENET_LLM_API_KEY=
SAFENET_LLM_MODEL=
# Optional official YouTube Data API v3 key.
SAFENET_YOUTUBE_API_KEY=
# Local speech/OCR; in Compose mount existing data/models read-only.
SAFENET_MEDIA_ENABLED=true
SAFENET_MEDIA_TIMEOUT_SECONDS=300
# Optional local vision descriptions (not risk evidence). Empty disables them.
SAFENET_VISION_URL=http://127.0.0.1:11434
SAFENET_VISION_MODEL=qwen3-vl:2b-instruct
