{
  "name": "safenet-kz",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "description": "Automatic, explainable screening of paid lotteries, hidden casino promotion and financial pyramids for SafeNet KZ — humans review only the queue",
  "scripts": {
    "dev": "node server/index.mjs --dev",
    "prebuild": "node scripts/package-extension.mjs && node scripts/setup-ocr.mjs",
    "build": "vite build",
    "start": "node server/index.mjs",
    "test": "node --test server/*.test.mjs extension/*.test.mjs",
    "evaluate": "node scripts/evaluate.mjs",
    "setup:ocr": "node scripts/setup-ocr.mjs",
    "verify:qr": "node scripts/verify-qr.mjs",
    "train": "node scripts/train-model.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "parse5": "^8.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/kaz": "^1.0.0",
    "@tesseract.js-data/rus": "^1.0.0",
    "vite": "^6.4.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
