# Optional official Meta Ad Library access. Leave blank unless Meta granted access.
# Use the Graph API version supported by YOUR Meta app, for example vNN.0.
# Copy to .env locally; never share the filled file or paste a token into chat.
SAFENET_META_ACCESS_TOKEN=
SAFENET_META_API_VERSION=

# Railway sets RAILWAY_ENVIRONMENT and PORT automatically.
# To use the same hosting mode elsewhere, set SAFENET_HOSTED=1.
SAFENET_HOSTED=0
# Empty: public read-only dashboard and stateless text/OCR analysis.
# Set a strong secret in the hosting dashboard for the full private analyst workspace.
# HTTP Basic login accepts any username; the password is this key. Use HTTPS.
SAFENET_ACCESS_KEY=
# Optional comma-separated extra domains. Railway's public domain is included automatically.
SAFENET_ALLOWED_HOSTS=
# Optional absolute path for cases, decisions, monitoring and discovery state.
# Falls back to RAILWAY_VOLUME_MOUNT_PATH on Railway, otherwise ./data.
# Mount the Railway volume at /data (NOT /app/data, which holds bundled assets).
SAFENET_DATA_DIR=
